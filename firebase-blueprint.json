{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Registry of platform owner and club admin UIDs.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["owner", "admin"] },
        "name": { "type": "string", "maxLength": 100 }
      },
      "required": ["uid", "role"]
    },
    "Club": {
      "title": "Club",
      "description": "University chess club configuration and branding.",
      "type": "object",
      "properties": {
        "clubId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clubName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "subtitleAr": { "type": "string", "maxLength": 160 },
        "universityName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "city": { "type": "string", "maxLength": 100 },
        "primaryColor": { "type": "string", "maxLength": 20 },
        "secondaryColor": { "type": "string", "maxLength": 20 },
        "accentColor": { "type": "string", "maxLength": 20 },
        "customLogoUrl": { "type": "string", "maxLength": 200000 },
        "schoolLogoUrl": { "type": "string", "maxLength": 200000 },
        "clubBannerUrl": { "type": "string", "maxLength": 200000 },
        "customHeroUrl": { "type": "string", "maxLength": 200000 },
        "startingRating": { "type": "number" },
        "weekMode": { "type": "string", "enum": ["algeria_sat_thu", "intl_mon_sat"] },
        "campusZones": { "type": "array" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["clubId", "clubName", "universityName", "primaryColor", "accentColor", "startingRating", "weekMode"]
    },
    "Member": {
      "title": "Member",
      "description": "Public club player profile without sensitive emails or plaintext passwords.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clubId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authUid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "arabicName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "minLength": 2, "maxLength": 64 },
        "role": { "type": "string", "enum": ["owner", "admin", "member"] },
        "clubRoleDivision": { "type": "string", "maxLength": 80 },
        "chessSpecialty": { "type": "string", "maxLength": 120 },
        "signatureOpening": { "type": "string", "maxLength": 160 },
        "chessComUsername": { "type": "string", "maxLength": 80 },
        "onlineEloBracket": { "type": "string", "maxLength": 80 },
        "bringsEquipment": { "type": "boolean" },
        "willingToCoach": { "type": "boolean" },
        "willingToOrganize": { "type": "boolean" },
        "clubExpectation": { "type": "string", "maxLength": 400 },
        "isDesignatedSuccessor": { "type": "boolean" },
        "university": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "maxLength": 120 },
        "yearLevel": { "type": "string", "maxLength": 80 },
        "titleBadge": { "type": "string", "maxLength": 100 },
        "liveStatus": { "type": "string", "enum": ["campus_otb", "online_ready", "in_lecture", "offline"] },
        "bio": { "type": "string", "maxLength": 600 },
        "avatarUrl": { "type": "string", "maxLength": 200000 },
        "coverPhotoUrl": { "type": "string", "maxLength": 220000 },
        "profilePhotos": { "type": "array" },
        "avatarInitials": { "type": "string", "maxLength": 8 },
        "avatarColor": { "type": "string", "maxLength": 24 },
        "joinedDate": { "type": "string", "maxLength": 40 },
        "fide": { "type": "object" },
        "glicko2": { "type": "object" },
        "ratingHistory": { "type": "array" },
        "openings": { "type": "array" },
        "freeSlots": { "type": "array" },
        "campusMeetupZoneId": { "type": "string", "maxLength": 80 },
        "gpsLocation": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "clubId", "name", "username", "role", "liveStatus", "fide", "glicko2"]
    },
    "ClubGame": {
      "title": "ClubGame",
      "description": "Verified or pending chess match between two club members.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clubId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 180 },
        "event": { "type": "string", "maxLength": 140 },
        "date": { "type": "string", "maxLength": 40 },
        "whiteId": { "type": "string", "maxLength": 128 },
        "blackId": { "type": "string", "maxLength": 128 },
        "result": { "type": "string", "enum": ["1-0", "1/2-1/2", "0-1"] },
        "timeControl": { "type": "string", "enum": ["rapid", "blitz", "classical"] },
        "matchStakes": { "type": "string", "enum": ["friendly", "competitive", "tournament"] },
        "eco": { "type": "string", "maxLength": 16 },
        "openingName": { "type": "string", "maxLength": 160 },
        "pgn": { "type": "string", "maxLength": 10000 },
        "status": { "type": "string", "enum": ["approved", "pending"] },
        "submittedBy": { "type": "string", "maxLength": 128 },
        "submittedByUid": { "type": "string", "maxLength": 128 },
        "whiteEloDelta": { "type": "number" },
        "blackEloDelta": { "type": "number" },
        "tournamentId": { "type": "string", "maxLength": 128 },
        "moves": { "type": "array" }
      },
      "required": ["id", "clubId", "whiteId", "blackId", "result", "timeControl", "pgn", "status"]
    },
    "ClubPost": {
      "title": "ClubPost",
      "description": "Home screen news announcement or tournament recap created by club admins.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clubId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "category": { "type": "string", "maxLength": 60 },
        "body": { "type": "string", "minLength": 2, "maxLength": 4000 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorRole": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "pinned": { "type": "boolean" }
      },
      "required": ["id", "clubId", "title", "category", "body", "authorName", "createdAt"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Computer-paired club tournament across 7 formats.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clubId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "format": {
          "type": "string",
          "enum": ["swiss", "knockout", "double_elimination", "round_robin", "double_round_robin", "scheveningen", "arena"]
        },
        "timeControl": { "type": "string", "enum": ["rapid", "blitz", "classical"] },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "currentRound": { "type": "number" },
        "totalRounds": { "type": "number" },
        "playerIds": { "type": "array" },
        "matches": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "clubId", "name", "format", "timeControl", "status", "currentRound", "totalRounds"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Internal club team channel or 1-on-1 direct message.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clubId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "channelId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "channelType": { "type": "string", "enum": ["team", "dm"] },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderAuthUid": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "senderRole": { "type": "string", "enum": ["owner", "admin", "member"] },
        "recipientId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "challengeTimeControl": { "type": "string", "enum": ["rapid", "blitz", "classical"] },
        "challengeStakes": { "type": "string", "enum": ["friendly", "competitive", "tournament"] },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "clubId", "channelId", "channelType", "senderId", "senderName", "text", "createdAt"]
    },
    "LineageRecord": {
      "title": "LineageRecord",
      "description": "Next-generation ownership inheritance handover record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clubId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "generationLabel": { "type": "string", "maxLength": 120 },
        "MandatePeriod": { "type": "string", "maxLength": 80 },
        "fromOwnerId": { "type": "string", "maxLength": 128 },
        "fromOwnerName": { "type": "string", "maxLength": 100 },
        "toOwnerId": { "type": "string", "maxLength": 128 },
        "toOwnerName": { "type": "string", "maxLength": 100 },
        "toOwnerDepartment": { "type": "string", "maxLength": 140 },
        "transferredAt": { "type": "string", "maxLength": 60 },
        "legacyNote": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "clubId", "generationLabel", "fromOwnerId", "toOwnerId", "transferredAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Registry of platform admin and owner UIDs."
    },
    "/clubs/{clubId}": {
      "schema": { "$ref": "#/entities/Club" },
      "description": "University chess clubs."
    },
    "/clubs/{clubId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/Member" },
      "description": "Public club-scoped member profiles and Elo ratings (zero PII)."
    },
    "/clubs/{clubId}/games/{gameId}": {
      "schema": { "$ref": "#/entities/ClubGame" },
      "description": "Club-scoped PGN or result-only games."
    },
    "/clubs/{clubId}/posts/{postId}": {
      "schema": { "$ref": "#/entities/ClubPost" },
      "description": "Club-scoped home screen announcements."
    },
    "/clubs/{clubId}/tournaments/{tournamentId}": {
      "schema": { "$ref": "#/entities/Tournament" },
      "description": "Club-scoped computer-paired tournaments."
    },
    "/clubs/{clubId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Club-scoped team channel and private direct messages."
    },
    "/clubs/{clubId}/lineage/{recordId}": {
      "schema": { "$ref": "#/entities/LineageRecord" },
      "description": "Club-scoped next-generation ownership lineage records."
    }
  }
}
